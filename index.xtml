<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Моё мини-приложение</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <style>
    body {
      font-family: -apple-system, 'Segoe UI', Roboto, sans-serif;
      background: var(--tg-theme-bg-color, #fff);
      color: var(--tg-theme-text-color, #000);
      text-align: center;
      padding-top: 60px;
    }
    button {
      padding: 14px 28px;
      font-size: 18px;
      border: none;
      border-radius: 12px;
      background: var(--tg-theme-button-color, #3390ec);
      color: var(--tg-theme-button-text-color, #fff);
    }
  </style>
</head>
<body>
  <h1>Привет!</h1>
  <p id="user-info">Загружаю...</p>
  <button onclick="sendMessage()">Отправить сообщение боту</button>

  <script>
    const tg = window.Telegram.WebApp;

    // Сообщаем Telegram, что приложение готово — исчезнет заставка загрузки
    tg.ready();

    // Показываем данные о пользователе
    const user = tg.initDataUnsafe?.user;
    if (user) {
      document.getElementById('user-info').textContent =
        'Привет, ' + (user.first_name || 'друг') + '!';
    } else {
      document.getElementById('user-info').textContent = 'Открой меня из Telegram 🙂';
    }

    function sendMessage() {
      tg.HapticFeedback.impactOccurred('light'); // лёгкая вибрация
      tg.sendData('Кнопка нажата!'); // уходит боту как сообщение
      tg.close();
    }
  </script>
</body>
</html>